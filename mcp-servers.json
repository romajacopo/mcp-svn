{
  "mcpServers": {
    "mcp-jenkins": {
      "command": "node",
      "args": ["services/mcp-jenkins/dist/index.js"],
      "env": {
        "JENKINS_URL": "https://jenkins-eks-dev-cpm-trk.platformteam.saastagetik.internal",
        "JENKINS_USER": "${JENKINS_USER}",
        "JENKINS_TOKEN": "${JENKINS_TOKEN}",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    },
    "mcp-jira": {
      "command": "node",
      "args": ["services/mcp-jira/dist/index.js"],
      "env": {
        "JIRA_URL": "http://localhost:8090",
        "JIRA_USER": "admin",
        "JIRA_TOKEN": "${JIRA_TOKEN}"
      }
    },
    "mcp-svn": {
      "command": "node",
      "args": ["services/mcp-svn/dist/index.js"],
      "env": {
        "SVN_URL": "svn://linux02.platformteam.saastagetik.internal/Dev/solutions/cpm",
        "SVN_USER": "${SVN_USER}",
        "SVN_PASSWORD": "${SVN_PASSWORD}"
      }
    },
    "mcp-graphify": {
      "command": "node",
      "args": ["services/mcp-graphify/dist/index.js"],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}"
      }
    },
    "mcp-orchestrator": {
      "command": "npx",
      "args": ["tsx", "services/mcp-orchestrator/src/index.ts"],
      "env": {
        "JENKINS_URL": "https://jenkins-eks-dev-cpm-trk.platformteam.saastagetik.internal",
        "JENKINS_USER": "${JENKINS_USER}",
        "JENKINS_TOKEN": "${JENKINS_TOKEN}",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0",
        "JIRA_URL": "http://localhost:8090",
        "JIRA_USER": "admin",
        "JIRA_TOKEN": "${JIRA_TOKEN}",
        "JIRA_PROJECT": "EAR",
        "SVN_URL": "svn://linux02.platformteam.saastagetik.internal/Dev/solutions/cpm",
        "SVN_USER": "${SVN_USER}",
        "SVN_PASSWORD": "${SVN_PASSWORD}",
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}"
      }
    }
  }
}
