# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in real values.
# `mcp-servers.json` references these via ${VAR} so secrets stay in this file.
#
# Two usage modes:
#   1. LOCAL test stack (docker compose) — defaults below work out of the box.
#   2. COMPANY infra — overwrite the URLs in mcp-servers.json and set real
#      USER/TOKEN/PASSWORD here. Only Neo4j stays local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Jenkins ──────────────────────────────────────────────────────────────────
# Local stack:    JENKINS_USER=admin  JENKINS_TOKEN=admin
# Company:        JENKINS_USER=<your.user>
#                 JENKINS_TOKEN=<API token from Jenkins → user → Configure>
JENKINS_USER=admin
JENKINS_TOKEN=admin
# Host port for the local Jenkins UI (change if 8080 is taken: `make up JENKINS_PORT=8085`)
JENKINS_PORT=8080

# ── Jira ─────────────────────────────────────────────────────────────────────
JIRA_USER=admin
JIRA_TOKEN=your_jira_api_token
JIRA_DB_PASSWORD=jira_secret

# ── Subversion ───────────────────────────────────────────────────────────────
# Local stack:    SVN_USER=developer  SVN_PASSWORD=svn_secret
# Company:        SVN_USER=<your.user>  SVN_PASSWORD=<your svn password>
SVN_USER=developer
SVN_PASSWORD=svn_secret

# ── Neo4j (Graphify) — stays local even for company use ──────────────────────
NEO4J_PASSWORD=graphify_secret

# ── Company endpoint hints (set the actual URLs in mcp-servers.json) ─────────
# JENKINS_URL=https://jenkins.your-company.com
# SVN_URL=svn://svn.your-company.com/repo
# JIRA_URL=https://jira.your-company.com
#
# If company Jenkins uses a self-signed certificate, add to its env block in
# mcp-servers.json:   "NODE_TLS_REJECT_UNAUTHORIZED": "0"
# (or set NODE_EXTRA_CA_CERTS to your corporate CA bundle for a proper fix).
