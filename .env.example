# ─────────────────────────────────────────────────────────────────────────────
# LOCAL test stack secrets (docker-compose). Copy to `.env`.
# For COMPANY use you normally don't run Jenkins/Jira/SVN locally — instead point
# the MCP servers at company URLs in `mcp-servers.json` (see README "Point it at
# your company servers"). Only Neo4j (the code knowledge graph) stays local.
# ─────────────────────────────────────────────────────────────────────────────

# Jenkins (local stack admin password = JENKINS_TOKEN value)
JENKINS_USER=admin
JENKINS_TOKEN=admin
# Host port for the local Jenkins UI (change if 8080 is taken): make up JENKINS_PORT=8085
JENKINS_PORT=8080

# Jira
JIRA_USER=admin
JIRA_TOKEN=your_jira_api_token
JIRA_DB_PASSWORD=jira_secret

# Subversion
SVN_USER=developer
SVN_PASSWORD=svn_secret

# Neo4j (Graphify) — stays local even for company use
NEO4J_PASSWORD=graphify_secret

# ── Company endpoints (used when running the MCP servers against real infra) ──
# Prefer setting these in mcp-servers.json. Listed here for reference:
# JENKINS_URL=https://jenkins.your-company.com
# SVN_URL=https://svn.your-company.com/repo/trunk
# JIRA_URL=https://jira.your-company.com
